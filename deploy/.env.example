# Референс переменных, которые нужны prod-compose.
#
# ВАЖНО: на сервере .env НЕ создаётся. Все значения приходят из GitHub Secrets
# и инъектируются CD в момент деплоя (см. job `deploy` в .github/workflows/ci.yml).
# Этот файл — только шпаргалка «какие секреты завести в репозитории» и для
# РУЧНОГО локального запуска prod-compose при отладке.
#
# GitHub Secrets, которые читает CD:
#   YC_REGISTRY_ID     — ID реестра Yandex CR (crpXXXXXXXXXXXX)
#   YC_SA_JSON_KEY     — JSON-ключ сервисного аккаунта (docker login по stdin)
#   POSTGRES_PASSWORD  — пароль postgres (идёт и в БД, и в DATABASE_URL монолита)
#   RABBITMQ_USER      — учётка RabbitMQ (по умолчанию smarthome)
#   RABBITMQ_PASS      — пароль RabbitMQ (по умолчанию smarthome)
#   VPS_HOST / VPS_USER / VPS_SSH_KEY / VPS_SSH_KNOWN_HOSTS — доступ по SSH
#   IMAGE_TAG          — НЕ секрет: CD подставляет git SHA автоматически

YC_REGISTRY_ID=
POSTGRES_PASSWORD=
RABBITMQ_USER=smarthome
RABBITMQ_PASS=smarthome
# IMAGE_TAG=latest
