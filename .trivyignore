# ─────────────────────────────────────────────────────────────────────────────
# Trivy ignore list — CVE, на которые НЕ падает security-гейт в CI.
#
# ВНИМАНИЕ: это подавление, а не фикс. «Правильный» путь для большинства из них —
# бамп зависимостей/базовых образов (pgx, x/crypto, x/net, Go toolchain, npm-деп).
# Здесь они заигнорены осознанно, чтобы гейт проходил на текущих версиях.
# TODO: пересмотреть после обновления образов и `go get -u` / `npm update`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Alpine OS-пакеты (base node:20-alpine): c-ares, libexpat ──
CVE-2026-33630   # c-ares 1.34.6-r0 → 1.34.8-r0  (use-after-free / double-free)
CVE-2026-56131   # libexpat 2.8.1-r0 → 2.8.2-r0  (handler call depth)
CVE-2026-56407   # libexpat  (integer overflow in doProlog)
CVE-2026-56408   # libexpat  (integer overflow in copyString)

# ── Go: github.com/jackc/pgx/v5 (fixed 5.5.4 / 5.9.0) ──
CVE-2026-33815   # CRITICAL  memory-safety
CVE-2026-33816   # CRITICAL  memory-safety
CVE-2024-27304   # SQL injection via protocol message size overflow

# ── Go: golang.org/x/crypto (fixed ≤ 0.52.0) ──
CVE-2024-45337   # ssh PublicKeyCallback authz bypass
CVE-2025-22869   # ssh key-exchange DoS
CVE-2025-47913   # ssh/agent client panic
CVE-2026-39828   # ssh unauthorized command execution
CVE-2026-39829   # ssh DoS via crafted public key
CVE-2026-39830   # ssh DoS via resource leak
CVE-2026-39831   # ssh security-key bypass
CVE-2026-39832   # ssh/agent key-restriction bypass
CVE-2026-39835   # ssh DoS via crafted certificate
CVE-2026-42508   # ssh/knownhosts revocation bypass
CVE-2026-46595   # ssh source-address validation bypass
CVE-2026-46597   # ssh AES-GCM decoder DoS

# ── Go: golang.org/x/net (fixed ≤ 0.55.0) ──
CVE-2022-41723   # http2 HPACK quadratic complexity
CVE-2023-39325   # http2 rapid stream reset (CVE-2023-44487)
CVE-2023-45288   # http2 CONTINUATION flood DoS
CVE-2024-45338   # html non-linear parsing DoS
CVE-2026-25681   # html XSS / code execution
CVE-2026-27136   # html XSS via parsing bypass
CVE-2026-33814   # http2 DoS via SETTINGS_MAX_FRAME_SIZE (также stdlib)
CVE-2026-39821   # idna privilege escalation via Punycode

# ── Go: stdlib (fixed в 1.24.x / 1.25.x / 1.26.x) ──
CVE-2025-68121   # CRITICAL  crypto/tls cert validation on session resumption
CVE-2025-61726   # net/url memory exhaustion
CVE-2025-61729   # crypto/x509 DoS
CVE-2026-25679   # net/url IPv6 host literal parsing
CVE-2026-27145   # crypto/x509 DoS via DNS
CVE-2026-32280   # crypto/x509 chain-building DoS
CVE-2026-32281   # crypto/x509 chain-validation DoS
CVE-2026-32283   # crypto/tls TLS1.3 key DoS
CVE-2026-33811   # net long CNAME DoS
CVE-2026-39820   # net/mail DoS
CVE-2026-39822   # os.Root symlink traversal
CVE-2026-39836   # golang security update (ELSA-2026-22121)
CVE-2026-42499   # net/mail DoS
CVE-2026-42504   # mime DoS

# ── npm-бандл в node:20-alpine (npm / node-gyp внутренние деп) ──
CVE-2024-21538   # cross-spawn ReDoS (fixed 7.0.5)
CVE-2025-64756   # glob command injection (fixed 10.5.0)
CVE-2026-26996   # minimatch DoS (fixed 9.0.6)
CVE-2026-27903   # minimatch DoS backtracking (fixed 9.0.7)
CVE-2026-27904   # minimatch catastrophic backtracking (fixed 9.0.7)
CVE-2026-48815   # sigstore certificateOIDs constraints dropped (fixed 4.1.1)
CVE-2026-23745   # node-tar symlink poisoning (fixed 7.5.3)
CVE-2026-23950   # node-tar unicode path collision (fixed 7.5.4)
CVE-2026-24842   # node-tar hardlink path traversal (fixed 7.5.7)
CVE-2026-26960   # node-tar malicious archive hardlink (fixed 7.5.8)
CVE-2026-29786   # node-tar drive-relative linkpath traversal (fixed 7.5.10)
